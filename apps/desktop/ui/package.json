{
  "name": "@xtrace/desktop-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && pnpm lint:hex",
    "tauri": "cd ../src-tauri && tauri",
    "lint:hex": "node scripts/lint-hex.mjs",
    "test:e2e": "playwright test",
    "test:e2e:gallery": "playwright test --config playwright.gallery.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tanstack/react-query": "5.102.8",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.18.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
