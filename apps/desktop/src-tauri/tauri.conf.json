{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XTrace Desktop",
  "version": "0.1.0",
  "identifier": "ai.xtrace.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XTrace Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 30 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../ui/public/icons/icon.png", "../ui/public/icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
