{
  "name": "xtrace-desktop-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "pnpm --dir apps/desktop/ui dev",
    "build": "pnpm --dir apps/desktop/ui build",
    "test": "node --test apps/desktop/ui/scripts/*.test.mjs && pnpm --dir apps/desktop/ui test",
    "typecheck": "pnpm --dir apps/desktop/ui typecheck",
    "lint": "eslint . --max-warnings 0 && pnpm --dir apps/desktop/ui lint:hex",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "tauri": "pnpm --dir apps/desktop/ui tauri",
    "e2e": "pnpm --dir apps/desktop/ui exec playwright test",
    "test:ci": "node --test scripts/ci/*.test.mjs",
    "sbom": "node scripts/supply-chain/sbom.mjs",
    "notices": "sh scripts/notices.sh",
    "notices:check": "sh scripts/notices.sh --check",
    "test:supply-chain": "node --test scripts/supply-chain/*.test.mjs",
    "security:scan": "node scripts/security/scan-secrets.mjs",
    "secrets:check": "node scripts/security/scan-secrets.mjs",
    "publication:check": "node scripts/publication/check.mjs",
    "publication:test": "node --test scripts/publication/*.test.mjs scripts/security/*.test.mjs",
    "check:native": "node scripts/ci/native-check.mjs",
    "fixtures:export": "bash scripts/fixtures/export.sh",
    "e2e:production": "pnpm --dir apps/desktop/ui exec playwright test --config playwright.production.config.ts",
    "e2e:gallery": "pnpm --dir apps/desktop/ui test:e2e:gallery"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "commonmark": "0.31.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "spdx-expression-parse": "5.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
