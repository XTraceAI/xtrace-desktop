{
  "enabledPlugins": {
    "cloudflare@cloudflare": false,
    "legacy@legacy": "yes",
    "memhub@memhub": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/synthetic/bin/guard --token SYNTHETIC-FIXTURE-VALUE" }
        ]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/synthetic/bin/summary" }] },
      { "matcher": "  ", "hooks": [] }
    ]
  }
}
